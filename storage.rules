rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        firestore.get(/databases/(default)/documents/admin_users/$(request.auth.uid)).data.role == 'super_admin' ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.role in ['admin', 'operations_admin', 'catalog_manager'] ||
        firestore.get(/databases/(default)/documents/admin_users/$(request.auth.uid)).data.role in ['admin', 'operations_admin', 'catalog_manager'] ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'operations_admin']
      );
    }

    function isValidStoryMedia() {
      return (
        request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/png',
          'image/webp',
          'image/jpg'
        ]
      ) && request.resource.size <= 10 * 1024 * 1024; // Max 10 MB
    }

    function isValidCertificateFile() {
      return (
        request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/png',
          'image/webp',
          'image/jpg'
        ]
      ) && request.resource.size <= 10 * 1024 * 1024; // Max 10 MB (Section 8 & 34)
    }

    // =========================================================================
    // Company Gallery & Success Stories Storage Bucket
    // Path: /company-gallery/{category}/{filename}
    // =========================================================================
    match /company-gallery/{allPaths=**} {
      // Public read access so visitors can view company images
      allow read: if true;

      // Admin write access with image/PDF <= 10MB validation
      allow write: if isAdmin() && isValidStoryMedia();

      // Admin delete access
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Company Certifications & Official Documents Storage Bucket
    // Path: /company-certifications/{category}/{filename}
    // =========================================================================
    match /company-certifications/{allPaths=**} {
      // Public read access for published official documents
      allow read: if true;

      // Admin write access: PDF/Image <= 10MB validation
      allow write: if isAdmin() && isValidCertificateFile();

      // Admin delete access
      allow delete: if isAdmin();
    }

    // Default deny for unmapped storage paths
    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}

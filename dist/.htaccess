<IfModule mod_env.c>
  PassEnv RESEND_API_KEY
  PassEnv VITE_RESEND_API_KEY
  PassEnv RAZORPAY_KEY_ID
  PassEnv RAZORPAY_KEY_SECRET
  PassEnv EMAIL_FROM
</IfModule>

<IfModule mod_mime.c>
  AddType application/pdf .pdf
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType application/javascript .js
  AddType text/css .css
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml font/woff font/woff2
</IfModule>

<IfModule mod_headers.c>
  # Production SSL/TLS & Security Headers (Scoped without wildcard subdomains to prevent ERR_CERT_COMMON_NAME_INVALID)
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HTML documents - Never cache index.html
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Immutable hashed frontend bundles
  <FilesMatch "\.(js|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Media and image assets
  <FilesMatch "\.(pdf|png|jpe?g|webp|svg|ico)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>

<IfModule LiteSpeed>
  CacheEngine on
  CacheLookup on
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Canonical Domain & HTTPS Normalization
  # Redirect any IP address, internal LiteSpeed proxy alias or unmapped host to canonical domain
  RewriteCond %{HTTP_HOST} !^(www\.)?kognitiminds\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteRule ^(.*)$ https://kognitiminds.com/$1 [R=301,L]

  # Strictly enforce HTTPS on the current valid domain (supports both www.kognitiminds.com and kognitiminds.com seamlessly)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Strip tracking query parameters (e.g. srsltid from Google Search/Merchant)
  RewriteCond %{QUERY_STRING} (?:^|&)srsltid=[^&]* [NC]
  RewriteRule ^(.*)$ https://kognitiminds.com/$1? [R=301,L]

  # 1. Direct Native Handlers for Production APIs (Zero proxy overhead, zero 503 errors)
  RewriteRule ^api/auth/send-otp/?$ api/send-email.php [QSA,L]
  RewriteRule ^api/resend/?$ api/send-email.php [QSA,L]
  RewriteRule ^api/health/?$ api/health.php [QSA,L]
  RewriteRule ^api/upload/?$ api/upload.php [QSA,L]
  RewriteRule ^api/data/([a-zA-Z0-9_-]+)/?([a-zA-Z0-9_-]*)?$ api/data.php?collection=$1&id=$2 [QSA,L]

  # 2. Direct Static Upload Serving
  RewriteRule ^uploads/(.*)$ uploads/$1 [L]

  # 3. Dedicated ONDC Protocol routes to Node.js backend (Port 3000) ONLY
  <IfModule mod_proxy.c>
    RewriteCond %{REQUEST_URI} !\.php$ [NC]
    RewriteCond %{REQUEST_URI} ^/(search|select|init|confirm|status|cancel|update|rating|track|support|ondc) [NC]
    RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
  </IfModule>

  # 4. Serve physical static files and directories directly if they exist
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Guard: Missing static assets return clean 404 (NEVER rewrite .js/.css to index.html)
  RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot|pdf)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 6. Client-side SPA route fallback
  RewriteRule . /index.html [L]
</IfModule>

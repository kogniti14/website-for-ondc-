<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct Native Handlers for Production APIs (Zero proxy overhead, zero 503 errors)
  RewriteRule ^api/auth/send-otp/?$ api/send-email.php [QSA,L]
  RewriteRule ^api/resend/?$ api/send-email.php [QSA,L]
  RewriteRule ^api/health/?$ api/health.php [QSA,L]
  RewriteRule ^api/upload/?$ api/upload.php [QSA,L]
  RewriteRule ^api/data/([a-zA-Z0-9_-]+)/?([a-zA-Z0-9_-]*)?$ api/data.php?collection=$1&id=$2 [QSA,L]

  # 2. Do not rewrite existing physical files or PHP scripts
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Dedicated ONDC Protocol routes to Node.js backend (Port 3000) ONLY
  <IfModule mod_proxy.c>
    RewriteCond %{REQUEST_URI} !\.php$ [NC]
    RewriteCond %{REQUEST_URI} ^/(search|select|init|confirm|status|cancel|update|rating|track|support|ondc) [NC]
    RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
  </IfModule>

  # 4. Serve static files directly if they exist
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # 5. Client-side SPA route fallback
  RewriteRule . /index.html [L]
</IfModule>

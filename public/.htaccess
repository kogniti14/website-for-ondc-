<IfModule mod_headers.c>
  # Production SSL/TLS & Security Headers
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Canonical Domain Enforcement & HTTPS Normalization
  # Redirect www.kognitiminds.com to canonical https://kognitiminds.com
  RewriteCond %{HTTP_HOST} ^www\.kognitiminds\.com$ [NC]
  RewriteRule ^(.*)$ https://kognitiminds.com/$1 [R=301,L]

  # Enforce HTTPS if not already handled by CDN/Proxy
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 1. Direct Native Handlers for Production APIs (Zero proxy overhead, zero 503 errors)
  RewriteRule ^api/auth/send-otp/?$ api/send-email.php [QSA,L]
  RewriteRule ^api/resend/?$ api/send-email.php [QSA,L]
  RewriteRule ^api/health/?$ api/health.php [QSA,L]
  RewriteRule ^api/upload/?$ api/upload.php [QSA,L]
  RewriteRule ^api/data/([a-zA-Z0-9_-]+)/?([a-zA-Z0-9_-]*)?$ api/data.php?collection=$1&id=$2 [QSA,L]

  # 2. Direct Static Upload Serving
  RewriteCond %{DOCUMENT_ROOT}/public/uploads/$1 -f
  RewriteRule ^uploads/(.*)$ /public/uploads/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/uploads/$1 -f
  RewriteRule ^uploads/(.*)$ /uploads/$1 [L]

  # 3. Do not rewrite existing physical files or PHP scripts
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Dedicated ONDC Protocol routes to Node.js backend (Port 3000) ONLY
  <IfModule mod_proxy.c>
    RewriteCond %{REQUEST_URI} !\.php$ [NC]
    RewriteCond %{REQUEST_URI} ^/(search|select|init|confirm|status|cancel|update|rating|track|support|ondc) [NC]
    RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
  </IfModule>

  # 4. Serve static files directly if they exist
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # 5. Client-side SPA route fallback
  RewriteRule . /index.html [L]
</IfModule>

# =============================================================================
# Kogniti Minds - Production Environment Configuration Specification
# =============================================================================
# IMPORTANT SECURITY RULES:
# 1. Never commit `.env` or `.env.local` to Git.
# 2. Never put secret keys (payment secret, private keys) into VITE_* variables.
# 3. VITE_* variables are bundled into client-side JS and visible to visitors.
# 4. In Hostinger:
#    - For Node.js: Add server variables in hPanel -> Node.js -> Environment Variables.
#    - For client bundle: Set VITE_* variables during build or in local .env prior to build.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (Exposed to Browser Bundle)
# -----------------------------------------------------------------------------

# Firebase Cloud Authentication & Storage
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
VITE_FIREBASE_AUTH_DOMAIN=kognitiminds-ondc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kognitiminds-ondc
VITE_FIREBASE_STORAGE_BUCKET=kognitiminds-ondc.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=585231773951
VITE_FIREBASE_APP_ID=1:585231773951:web:1a71e21a858b5db71adcca
VITE_FIREBASE_MEASUREMENT_ID=G-LHW5GZQCCS

# Razorpay Official Checkout (Public Key ID ONLY - NEVER KEY SECRET)
VITE_RAZORPAY_KEY_ID=rzp_live_TarTjUQ1NhuUru

# Sender email for transactional notifications
VITE_EMAIL_FROM="Kogniti Minds Security <security@kognitiminds.com>"

# Optional Supabase client keys (if connecting directly from frontend)
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# -----------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (Hostinger Node.js / Server Environment ONLY)
# Never exposed to the browser. Kept safe in Node.js process.env
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Resend API Key for Transactional Emails (OTP, Invoices, Policy Updates)
RESEND_API_KEY=re_your_live_resend_api_key_here
EMAIL_FROM="Kogniti Minds Security <security@kognitiminds.com>"

# Razorpay Payment Gateway (Server-Side Verification & Webhooks)
RAZORPAY_KEY_ID=rzp_live_TarTjUQ1NhuUru
RAZORPAY_KEY_SECRET=your_live_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_optional_webhook_secret_here

# Supabase Cloud Database (Optional Hostinger integration)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# -----------------------------------------------------------------------------
# 3. ONDC eB2B Protocol Configuration (ONDC:RETeB2B v1.2.0)
# -----------------------------------------------------------------------------
ONDC_ENV=preprod
ONDC_SUBSCRIBER_ID=kognitiminds.com
ONDC_SUBSCRIBER_URI=https://kognitiminds.com
ONDC_REGISTRY_DOMAIN=ONDC:RETeB2B
ONDC_KEY_ID=kogniti-key-01
ONDC_PRIVATE_KEY=your_ed25519_signing_private_key_base64
ONDC_PUBLIC_KEY=your_ed25519_signing_public_key_base64
ONDC_ENCRYPTION_PRIVATE_KEY=your_x25519_encryption_private_key_base64
ONDC_ENCRYPTION_PUBLIC_KEY=your_x25519_encryption_public_key_base64
ONDC_REGISTRY_URL=https://preprod.registry.ondc.org/ondc
ONDC_BUYER_BASE_URL=https://workbench.ondc.tech/api-service/ONDC:RETeB2B/1.2.5/buyer



# =============================================================================
# Kogniti Minds - Production Authentication & Email OTP Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Firebase Cloud Authentication
# Get these keys from:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
VITE_FIREBASE_AUTH_DOMAIN=kogniti-minds.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kogniti-minds
VITE_FIREBASE_STORAGE_BUCKET=kogniti-minds.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# -----------------------------------------------------------------------------
# 2. Production Transactional Email OTP Delivery (Resend / Webhook / EmailJS)
# Primary: Resend API (https://resend.com)
# -----------------------------------------------------------------------------
VITE_RESEND_API_KEY=re_your_live_resend_api_key_here
VITE_EMAIL_FROM="Kogniti Minds Security <security@kognitiminds.com>"

# Optional Webhook fallback (e.g. AWS Lambda / Cloudflare Worker / custom backend)
# VITE_OTP_WEBHOOK_URL=https://api.yourdomain.com/auth/send-email-otp

# Optional EmailJS fallback (https://www.emailjs.com)
# VITE_EMAILJS_SERVICE_ID=service_kogniti
# VITE_EMAILJS_TEMPLATE_ID=template_otp
# VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# -----------------------------------------------------------------------------
# 3. Supabase Cloud Database Configuration (Hostinger Integration)
# -----------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# 4. ONDC eB2B Protocol Configuration (ONDC:RETeB2B)
# Used by the Node.js backend server on Hostinger / Production
# -----------------------------------------------------------------------------
PORT=3000
ONDC_ENV=preprod
ONDC_SUBSCRIBER_ID=kognitiminds.com
ONDC_SUBSCRIBER_URI=https://kognitiminds.com
ONDC_REGISTRY_DOMAIN=ONDC:RETeB2B
ONDC_KEY_ID=kogniti-key-01
ONDC_PRIVATE_KEY=your_ed25519_signing_private_key_base64
ONDC_PUBLIC_KEY=your_ed25519_signing_public_key_base64
ONDC_ENCRYPTION_PRIVATE_KEY=your_x25519_encryption_private_key_base64
ONDC_ENCRYPTION_PUBLIC_KEY=your_x25519_encryption_public_key_base64
ONDC_REGISTRY_URL=https://preprod.registry.ondc.org/ondc


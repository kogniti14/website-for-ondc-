DirectoryIndex dist/index.html index.html

<IfModule mod_env.c>
  PassEnv RESEND_API_KEY
  PassEnv VITE_RESEND_API_KEY
  PassEnv RAZORPAY_KEY_ID
  PassEnv RAZORPAY_KEY_SECRET
  PassEnv EMAIL_FROM
</IfModule>

<IfModule mod_mime.c>
  AddType application/pdf .pdf
  AddType application/zip .zip
  AddType application/json .json
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType application/javascript .js
  AddType text/css .css
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Enable Gzip / Deflate Compression for Speed and TTFB
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml font/woff font/woff2
</IfModule>

<IfModule mod_headers.c>
  # Production SSL/TLS & Security Headers (Strictly scoped without wildcard subdomains to avoid ERR_CERT_COMMON_NAME_INVALID)
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HTML documents - Never cache index.html so users always receive current asset bundles immediately
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Immutable hashed frontend bundles (Vite outputs hashed filenames)
  <FilesMatch "\.(js|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Media and image assets
  <FilesMatch "\.(pdf|png|jpe?g|webp|svg|ico)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>

<IfModule LiteSpeed>
  CacheEngine on
  CacheLookup on
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Canonical Domain & HTTPS Normalization
  # Redirect any IP address, internal LiteSpeed proxy alias or unmapped host to canonical domain
  RewriteCond %{HTTP_HOST} !^(www\.)?kognitiminds\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteRule ^(.*)$ https://kognitiminds.com/$1 [R=301,L]

  # Strictly enforce HTTPS on the current valid domain (supports both www.kognitiminds.com and kognitiminds.com seamlessly)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Strip tracking query parameters (e.g. srsltid from Google Search/Merchant)
  RewriteCond %{QUERY_STRING} (?:^|&)srsltid=[^&]* [NC]
  RewriteRule ^(.*)$ https://kognitiminds.com/$1? [R=301,L]

  # 1. Existing Physical Files & Directories (Serve immediately with zero overhead)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Direct Native Handlers for Production APIs (Zero proxy overhead, zero 503 errors)
  RewriteRule ^ondc/health/?$ public/api/ondc-gateway.php?action=health [QSA,L]
  RewriteRule ^health/?$ public/api/ondc-gateway.php?action=health [QSA,L]
  RewriteRule ^ondc-workbench-kit\.zip$ public/api/download-workbench.php?file=zip [QSA,L]
  RewriteRule ^ondc/download/workbench-kit/?$ public/api/download-workbench.php?file=zip [QSA,L]
  RewriteRule ^ondc/download/workbench-file/([a-zA-Z0-9_.-]+)$ public/api/download-workbench.php?file=$1 [QSA,L]
  RewriteRule ^api/admin/ondc/workbench/files/?$ public/api/download-workbench.php [QSA,L]
  RewriteRule ^api/auth/send-otp/?$ public/api/send-email.php [QSA,L]
  RewriteRule ^api/resend/?$ public/api/send-email.php [QSA,L]
  RewriteRule ^api/health/?$ public/api/health.php [QSA,L]
  RewriteRule ^api/upload/?$ public/api/upload.php [QSA,L]
  RewriteRule ^api/data/([a-zA-Z0-9_-]+)/?([a-zA-Z0-9_-]*)?$ public/api/data.php?collection=$1&id=$2 [QSA,L]

  # 3. Dedicated ONDC RETeB2B 1.2.5 Protocol Routes (Hostinger LiteSpeed Native Execution - Zero 503 errors)
  RewriteRule ^(search|select|init|confirm|status|track|cancel|update|rating|support)$ public/api/ondc-gateway.php?action=$1 [QSA,L]
  RewriteRule ^(on_search|on_select|on_init|on_confirm|on_status|on_track|on_cancel|on_update|on_rating|on_support)$ public/api/ondc-gateway.php?action=$1 [QSA,L]
  RewriteRule ^ondc/(search|select|init|confirm|status|track|cancel|update|rating|support)$ public/api/ondc-gateway.php?action=$1 [QSA,L]
  RewriteRule ^ondc/(on_search|on_select|on_init|on_confirm|on_status|on_track|on_cancel|on_update|on_rating|on_support)$ public/api/ondc-gateway.php?action=$1 [QSA,L]
  RewriteRule ^ondc/on_search_sample/?$ public/api/ondc-gateway.php?action=on_search_sample [QSA,L]

  # 4. Uploads resolution (public/uploads or uploads)
  RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

  # 5. Root index route -> always serve dist/index.html
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^index\.html$ dist/index.html [L]

  # 6. Direct /assets/* resolution (works whether assets is in ./assets or ./dist/assets)
  RewriteCond %{REQUEST_URI} ^/assets/ [NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # 7. Fallback to dist/ for root-level static files (e.g. logo-icon.png, favicon.ico)
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteRule ^([a-zA-Z0-9_-]+\.(png|jpe?g|gif|ico|svg|webp|woff2?|ttf|eot|pdf|zip|json))$ dist/$1 [L]

  # 8. Missing static assets guard (clean 404, never fallback to index.html for assets)
  RewriteCond %{REQUEST_URI} \.(js|css|png|jpe?g|gif|ico|svg|webp|woff2?|ttf|eot|pdf|zip|json)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 9. Client-side SPA route fallback (All navigation routes like /shop, /products, /admin go to dist/index.html)
  RewriteRule . dist/index.html [L]
</IfModule>

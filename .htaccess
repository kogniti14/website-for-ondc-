# Disable Directory Indexing / Browsing
Options -Indexes -MultiViews

<IfModule mod_env.c>
  PassEnv RESEND_API_KEY
  PassEnv VITE_RESEND_API_KEY
  PassEnv RAZORPAY_KEY_ID
  PassEnv RAZORPAY_KEY_SECRET
  PassEnv EMAIL_FROM
</IfModule>

<IfModule mod_mime.c>
  AddType application/pdf .pdf
  AddType application/zip .zip
  AddType application/json .json
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType application/javascript .js
  AddType text/css .css
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml font/woff font/woff2
</IfModule>

<IfModule mod_headers.c>
  # Production SSL/TLS & Complete Security Headers Suite
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"

  # HTML documents - Never cache index.html
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Immutable hashed frontend bundles
  <FilesMatch "\.(js|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Media and image assets
  <FilesMatch "\.(pdf|png|jpe?g|webp|svg|ico)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # ONDC Gateway & Protocol Endpoints CORS Suite
  <FilesMatch "\.(php|json)$">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, Digest, Date, X-Requested-With, Accept, X-Admin-Role, Origin, Cache-Control, Pragma"
  </FilesMatch>
</IfModule>

# Block access to hidden files, git repos, environment variables, and source configs
<FilesMatch "^\.(env|git|htaccess|htpasswd)|(\.(lock|sql|sh|bak|swp|yml|yaml)|package\.json|package-lock\.json|database\.rules\.json|tsconfig.*\.json|vite\.config\.ts)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

<IfModule LiteSpeed>
  CacheEngine on
  CacheLookup on
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass Authorization and Admin headers to PHP in CGI/FastCGI environments
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
  SetEnvIf X-Admin-Role "(.*)" HTTP_X_ADMIN_ROLE=$1

  # 0. Canonical Domain & HTTPS Normalization
  # Redirect apex domain (kognitiminds.com) to canonical www.kognitiminds.com (CDN-backed, valid SSL)
  RewriteCond %{HTTP_HOST} ^kognitiminds\.com$ [NC]
  RewriteRule ^(.*)$ https://www.kognitiminds.com/$1 [R=301,L]

  # Redirect any IP address, internal LiteSpeed proxy alias or unmapped host to canonical www domain
  RewriteCond %{HTTP_HOST} !^www\.kognitiminds\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteRule ^(.*)$ https://www.kognitiminds.com/$1 [R=301,L]

  # Strictly enforce HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://www.kognitiminds.com/$1 [R=301,L]

  # Strip tracking query parameters (e.g. srsltid from Google Search/Merchant)
  RewriteCond %{QUERY_STRING} (?:^|&)srsltid=[^&]* [NC]
  RewriteRule ^(.*)$ https://www.kognitiminds.com/$1? [R=301,L]

  # 1. Direct Native Handlers for Production APIs (Zero proxy overhead, zero 503 errors)
  RewriteRule ^api/ondc/health/?$ api/ondc-gateway.php?action=health [QSA,L]
  RewriteRule ^ondc/health/?$ api/ondc-gateway.php?action=health [QSA,L]
  RewriteRule ^health/?$ api/ondc-gateway.php?action=health [QSA,L]
  RewriteRule ^ondc-workbench-kit\.zip$ api/download-workbench.php?file=zip [QSA,L]
  RewriteRule ^ondc/download/workbench-kit/?$ api/download-workbench.php?file=zip [QSA,L]
  RewriteRule ^ondc/download/workbench-file/([^/]+)/?$ api/download-workbench.php?file=$1 [QSA,L]
  RewriteRule ^api/admin/ondc/workbench/files/?$ api/download-workbench.php [QSA,L]
  RewriteRule ^api/admin/ondc/workbench/simulate/?$ api/ondc-gateway.php?action=admin_simulate [QSA,L]
  RewriteRule ^api/admin/ondc/orders/?$ api/ondc-gateway.php?action=admin_orders [QSA,L]
  RewriteRule ^api/admin/ondc/orders/update/?$ api/ondc-gateway.php?action=admin_order_update [QSA,L]
  RewriteRule ^api/admin/ondc/orders/delete/?$ api/ondc-gateway.php?action=admin_order_delete [QSA,L]
  RewriteRule ^api/admin/ondc/transactions/?$ api/ondc-gateway.php?action=admin_transactions [QSA,L]
  RewriteRule ^api/admin/ondc/logs/?$ api/ondc-gateway.php?action=admin_logs [QSA,L]
  RewriteRule ^api/admin/ondc/stats/?$ api/ondc-gateway.php?action=admin_stats [QSA,L]
  RewriteRule ^api/auth/send-otp/?$ api/send-email.php [QSA,L]
  RewriteRule ^api/resend/?$ api/send-email.php [QSA,L]
  RewriteRule ^api/health/?$ api/health.php [QSA,L]
  RewriteRule ^api/upload/?$ api/upload.php [QSA,L]
  RewriteRule ^api/data/([a-zA-Z0-9_-]+)/?([a-zA-Z0-9_-]*)?$ api/data.php?collection=$1&id=$2 [QSA,L]

  # Dedicated ONDC RETeB2B 1.2.5 Protocol Routes (Hostinger Native Execution - Zero 503 errors)
  # 1a. Protocol Machine-to-Machine POST Endpoints (Buyer -> Seller Gateway & Callbacks)
  RewriteCond %{REQUEST_METHOD} ^POST$
  RewriteRule ^(search|select|init|confirm|status|track|cancel|update|rating|support)/?$ api/ondc-gateway.php?action=$1 [QSA,L]
  RewriteCond %{REQUEST_METHOD} ^POST$
  RewriteRule ^api/(search|select|init|confirm|status|track|cancel|update|rating|support)/?$ api/ondc-gateway.php?action=$1 [QSA,L]
  RewriteCond %{REQUEST_METHOD} ^POST$
  RewriteRule ^ondc/(search|select|init|confirm|status|track|cancel|update|rating|support)/?$ api/ondc-gateway.php?action=$1 [QSA,L]
  RewriteCond %{REQUEST_METHOD} ^POST$
  RewriteRule ^api/ondc/(search|select|init|confirm|status|track|cancel|update|rating|support)/?$ api/ondc-gateway.php?action=$1 [QSA,L]

  # Inbound Callbacks POST Endpoints
  RewriteCond %{REQUEST_METHOD} ^POST$
  RewriteRule ^(on_search|on_select|on_init|on_confirm|on_status|on_track|on_cancel|on_update|on_rating|on_support)/?$ api/ondc-gateway.php?action=$1 [QSA,L]
  RewriteCond %{REQUEST_METHOD} ^POST$
  RewriteRule ^api/(on_search|on_select|on_init|on_confirm|on_status|on_track|on_cancel|on_update|on_rating|on_support)/?$ api/ondc-gateway.php?action=$1 [QSA,L]
  RewriteCond %{REQUEST_METHOD} ^POST$
  RewriteRule ^ondc/(on_search|on_select|on_init|on_confirm|on_status|on_track|on_cancel|on_update|on_rating|on_support)/?$ api/ondc-gateway.php?action=$1 [QSA,L]
  RewriteCond %{REQUEST_METHOD} ^POST$
  RewriteRule ^api/ondc/(on_search|on_select|on_init|on_confirm|on_status|on_track|on_cancel|on_update|on_rating|on_support)/?$ api/ondc-gateway.php?action=$1 [QSA,L]

  # POST to Root or /api or /ondc or /api/ondc -> Route directly to ondc-gateway
  RewriteCond %{REQUEST_METHOD} ^POST$
  RewriteRule ^(api/ondc|ondc|api)?/?$ api/ondc-gateway.php [QSA,L]

  # 1b. CORS Preflight (OPTIONS)
  RewriteCond %{REQUEST_METHOD} ^OPTIONS$
  RewriteRule ^(search|select|init|confirm|status|track|cancel|update|rating|support)/?$ api/ondc-gateway.php?action=$1 [QSA,L]
  RewriteCond %{REQUEST_METHOD} ^OPTIONS$
  RewriteRule ^api/(search|select|init|confirm|status|track|cancel|update|rating|support)/?$ api/ondc-gateway.php?action=$1 [QSA,L]
  RewriteCond %{REQUEST_METHOD} ^OPTIONS$
  RewriteRule ^ondc/(search|select|init|confirm|status|track|cancel|update|rating|support)/?$ api/ondc-gateway.php?action=$1 [QSA,L]
  RewriteCond %{REQUEST_METHOD} ^OPTIONS$
  RewriteRule ^api/ondc/(search|select|init|confirm|status|track|cancel|update|rating|support)/?$ api/ondc-gateway.php?action=$1 [QSA,L]
  RewriteCond %{REQUEST_METHOD} ^OPTIONS$
  RewriteRule ^(api/ondc|ondc|api)?/?$ api/ondc-gateway.php [QSA,L]
  RewriteRule ^ondc/on_search_sample/?$ api/ondc-gateway.php?action=on_search_sample [QSA,L]

  # 3. Human browser navigation (GET / HEAD)
  # Internal callback routes -> Redirect to dedicated Admin SPA Workbench
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteRule ^on_([a-z]+)/?$ /admin/ondc/on-$1 [R=302,L]

  # Human browser navigation -> Load SPA (dist/index.html if in repo root mode, or index.html if in dist mode)
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^(search|select|init|confirm|status|track|track-order|tracking|cancel|cancel-order|update|rating|review|support|contact|help|products|shop|deals|offers|new-arrivals|innovations|product(/.*)?|category(/.*)?|story(/.*)?|certification(/.*)?|b2b(/.*)?|b2b-overview|wholesale-catalog|b2b-catalog|b2b-deals|rfq|b2b-rfq|business-dashboard|b2b-dashboard|b2b-cart|b2b-checkout|b2b-stories|b2b-compliance|success-stories|stories|certifications|certifications-compliance|compliance|business-login|business-register|gst-input-credit|gst-credit|itc-calculator|login|register|admin(/.*)?|wishlist|my-wishlist|cart|checkout|orders|my-orders|account|my-account|customer-dashboard|terms|terms-and-conditions|privacy|privacy-policy|refund|refund-policy|shipping|shipping-policy)/?$ dist/index.html [L]

  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteRule ^(search|select|init|confirm|status|track|track-order|tracking|cancel|cancel-order|update|rating|review|support|contact|help|products|shop|deals|offers|new-arrivals|innovations|product(/.*)?|category(/.*)?|story(/.*)?|certification(/.*)?|b2b(/.*)?|b2b-overview|wholesale-catalog|b2b-catalog|b2b-deals|rfq|b2b-rfq|business-dashboard|b2b-dashboard|b2b-cart|b2b-checkout|b2b-stories|b2b-compliance|success-stories|stories|certifications|certifications-compliance|compliance|business-login|business-register|gst-input-credit|gst-credit|itc-calculator|login|register|admin(/.*)?|wishlist|my-wishlist|cart|checkout|orders|my-orders|account|my-account|customer-dashboard|terms|terms-and-conditions|privacy|privacy-policy|refund|refund-policy|shipping|shipping-policy)/?$ index.html [L]

  # Root GET route -> dist/index.html if in repo root mode
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^$ dist/index.html [L]

  # 2. Direct Static Upload Serving
  RewriteRule ^uploads/(.*)$ uploads/$1 [L]

  # Direct /assets/* resolution for repo root mode
  RewriteCond %{DOCUMENT_ROOT}/dist/assets/$1 -f
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # 4. Serve physical static files and directories directly if they exist (EXCLUDE POST)
  RewriteCond %{REQUEST_METHOD} !^POST$
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Root-level static files resolution for repo root mode
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^([a-zA-Z0-9_-]+\.(png|jpe?g|gif|ico|svg|webp|woff|woff2|ttf|eot|pdf|zip|json))$ dist/$1 [L]

  # 5. Guard: Missing static assets return clean 404 (NEVER rewrite .js/.css to index.html)
  RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot|pdf)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 6. Client-side SPA route fallback (Non-POST)
  RewriteCond %{REQUEST_METHOD} !^POST$
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule . dist/index.html [L]

  RewriteCond %{REQUEST_METHOD} !^POST$
  RewriteRule . /index.html [L]
</IfModule>


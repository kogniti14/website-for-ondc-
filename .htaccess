<IfModule mod_env.c>
  PassEnv RESEND_API_KEY
  PassEnv VITE_RESEND_API_KEY
  PassEnv RAZORPAY_KEY_ID
  PassEnv RAZORPAY_KEY_SECRET
  PassEnv EMAIL_FROM
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct Native Handlers for Production APIs (Zero proxy overhead, zero 503 errors)
  RewriteRule ^api/auth/send-otp/?$ public/api/send-email.php [QSA,L]
  RewriteRule ^api/resend/?$ public/api/send-email.php [QSA,L]
  RewriteRule ^api/health/?$ public/api/health.php [QSA,L]
  RewriteRule ^api/data/([a-zA-Z0-9_-]+)/?([a-zA-Z0-9_-]*)?$ public/api/data.php?collection=$1&id=$2 [QSA,L]

  # 2. Never proxy PHP files to Node.js (executes via Hostinger LiteSpeed/Apache PHP engine)
  RewriteCond %{REQUEST_URI} \.php$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/api/$1 -f
  RewriteRule ^api/(.*\.php)$ api/$1 [L]

  RewriteCond %{REQUEST_URI} \.php$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/public/api/$1 -f
  RewriteRule ^api/(.*\.php)$ public/api/$1 [L]

  RewriteCond %{REQUEST_URI} \.php$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/dist/api/$1 -f
  RewriteRule ^api/(.*\.php)$ dist/api/$1 [L]

  # 3. Dedicated ONDC Protocol routes to Node.js backend (Port 3000) ONLY
  <IfModule mod_proxy.c>
    RewriteCond %{REQUEST_URI} !\.php$ [NC]
    RewriteCond %{REQUEST_URI} ^/(search|select|init|confirm|status|cancel|update|rating|track|support|ondc) [NC]
    RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
  </IfModule>

  # 4. Serve from dist/ if root is deployed
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 5. Serve static files directly if they exist
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # 6. Client-side SPA route fallback
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule . /dist/index.html [L]

  RewriteRule . /index.html [L]
</IfModule>

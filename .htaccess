DirectoryIndex dist/index.html index.html

<IfModule mod_env.c>
  PassEnv RESEND_API_KEY
  PassEnv VITE_RESEND_API_KEY
  PassEnv RAZORPAY_KEY_ID
  PassEnv RAZORPAY_KEY_SECRET
  PassEnv EMAIL_FROM
</IfModule>

<IfModule mod_mime.c>
  AddType application/pdf .pdf
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType application/javascript .js
  AddType text/css .css
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Enable Gzip / Deflate Compression for Speed and TTFB
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml font/woff font/woff2
</IfModule>

<IfModule mod_headers.c>
  # Production SSL/TLS & Security Headers (Strictly scoped without wildcard subdomains to avoid ERR_CERT_COMMON_NAME_INVALID)
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HTML documents - Never cache index.html so users always receive current asset bundles immediately
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Immutable hashed frontend bundles (Vite outputs hashed filenames)
  <FilesMatch "\.(js|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Media and image assets
  <FilesMatch "\.(pdf|png|jpe?g|webp|svg|ico)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>

<IfModule LiteSpeed>
  CacheEngine on
  CacheLookup on
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Canonical Domain Enforcement & HTTPS Normalization
  # Prevent ERR_CERT_COMMON_NAME_INVALID by strictly redirecting all non-canonical hostnames directly to https://kognitiminds.com
  RewriteCond %{HTTP_HOST} ^www\.kognitiminds\.com$ [NC]
  RewriteRule ^(.*)$ https://kognitiminds.com/$1 [R=301,L]

  # Redirect any IP address, alternate hostname or unmapped Hostinger alias to canonical https://kognitiminds.com
  RewriteCond %{HTTP_HOST} !^(www\.)?kognitiminds\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteRule ^(.*)$ https://kognitiminds.com/$1 [R=301,L]

  # Strictly enforce HTTPS to canonical domain (prevents %{HTTP_HOST} mismatch)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://kognitiminds.com/$1 [R=301,L]

  # Strip tracking query parameters (e.g. srsltid from Google Search/Merchant)
  RewriteCond %{QUERY_STRING} (?:^|&)srsltid=[^&]* [NC]
  RewriteRule ^(.*)$ https://kognitiminds.com/$1? [R=301,L]

  # 1. Direct Native Handlers for Production APIs (Zero proxy overhead, zero 503 errors)
  RewriteRule ^api/auth/send-otp/?$ public/api/send-email.php [QSA,L]
  RewriteRule ^api/resend/?$ public/api/send-email.php [QSA,L]
  RewriteRule ^api/health/?$ public/api/health.php [QSA,L]
  RewriteRule ^api/upload/?$ public/api/upload.php [QSA,L]
  RewriteRule ^api/data/([a-zA-Z0-9_-]+)/?([a-zA-Z0-9_-]*)?$ public/api/data.php?collection=$1&id=$2 [QSA,L]

  # 2. Uploads resolution (public/uploads or uploads)
  RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

  # 3. Dedicated ONDC Protocol routes to Node.js backend (Port 3000) ONLY
  <IfModule mod_proxy.c>
    RewriteCond %{REQUEST_URI} !\.php$ [NC]
    RewriteCond %{REQUEST_URI} ^/(search|select|init|confirm|status|cancel|update|rating|track|support|ondc) [NC]
    RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
  </IfModule>

  # 4. Root index route -> always serve dist/index.html
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^index\.html$ dist/index.html [L]

  # 5. Direct /assets/* resolution (works whether assets is in ./assets or ./dist/assets)
  RewriteCond %{REQUEST_URI} ^/assets/ [NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # 6. Physical files and directories served directly if present
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 7. Fallback to dist/ for root-level static files (e.g. logo-icon.png, favicon.ico)
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteRule ^([a-zA-Z0-9_-]+\.(png|jpe?g|gif|ico|svg|webp|woff2?|ttf|eot|pdf))$ dist/$1 [L]

  # 8. Missing static assets guard (clean 404, never fallback to index.html for assets)
  RewriteCond %{REQUEST_URI} \.(js|css|png|jpe?g|gif|ico|svg|webp|woff2?|ttf|eot|pdf)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 9. Client-side SPA route fallback (All navigation routes like /shop, /products, /admin go to dist/index.html)
  RewriteRule . dist/index.html [L]
</IfModule>

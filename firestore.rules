rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'super_admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.role in ['admin', 'operations_admin', 'catalog_manager'] ||
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role in ['admin', 'operations_admin', 'catalog_manager'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'operations_admin']
      );
    }

    // =========================================================================
    // 1. Gallery & Success Stories Collection
    // =========================================================================
    match /gallery/{storyId} {
      // Public / Customers / Visitors: Read-only access for published stories
      allow read: if resource.data.status == 'published' || isAdmin();

      // Admin & Super Admin: Write / create / update / delete access
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.imageUrl is string
        && request.resource.data.category is string
        && request.resource.data.visibility in ['both', 'b2b', 'b2c']
        && request.resource.data.status in ['published', 'draft', 'unpublished'];

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. Gallery Categories Collection (Super Admin Exclusive Management)
    // =========================================================================
    match /gallery_categories/{catId} {
      // Anyone can read categories
      allow read: if true;

      // Strictly Super Admin can create, update, reorder, or delete categories
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 3. Certifications Collection
    // =========================================================================
    match /certifications/{certId} {
      // Public / B2B / B2C Visitors: Read-only access for published certifications
      allow read: if resource.data.status == 'published' || isAdmin();

      // Admin & Super Admin: Write / create / update / delete access
      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.fileUrl is string
        && request.resource.data.category is string
        && request.resource.data.visibility in ['both', 'b2b', 'b2c']
        && request.resource.data.status in ['published', 'draft', 'unpublished'];

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 4. Certification Categories Collection (Super Admin Exclusive Management)
    // =========================================================================
    match /certification_categories/{catId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 3. User & Administrative Rules (Baseline Security)
    // =========================================================================
    match /admin_users/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /b2b_businesses/{bizId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == bizId || isSuperAdmin());
    }

    // Default deny for unhandled documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
